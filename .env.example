# Image Provenance System - Environment Configuration
# Copy to .env and adjust values

# Application
PROJECT_NAME=Image Provenance System
VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database
DATABASE_URL=postgresql+asyncpg://provenance:provenance@localhost:5432/provenance
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_S3_BUCKET=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Upload limits
MAX_UPLOAD_SIZE_MB=100

# Analysis
ANALYSIS_TIMEOUT_SECONDS=300
TEMP_DIR=./tmp

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Retention
RETENTION_HOURS=24
